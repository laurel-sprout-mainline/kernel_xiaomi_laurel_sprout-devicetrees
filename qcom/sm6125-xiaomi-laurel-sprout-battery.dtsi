&pmi632_charger {
	dpdm-supply = <&laurel_dpdm>;
	qcom,enable-hvdcp;
	qcom,parallel-charger = <&laurel_smb1355>;
	status = "okay";
	monitored-battery = <&laurel_battery>;
	input-current-limit-microamp = <2000000>;
	/* Stock hard comparator codes: cold 0 C, hot 60 C. */
	qcom,jeita-hard-thresholds = <0x6894 0x15aa>;
};

&pmi632_qg {
	status = "okay";
	nvmem-cells = <&pmi632_qg_magic>, <&pmi632_qg_cycles>,
		      <&pmi632_qg_learned_capacity>, <&laurel_qg_soc_valid>,
		      <&laurel_qg_soc_state>;
	nvmem-cell-names = "history-magic", "cycle-count-buckets", "learned-capacity",
			   "soc-valid", "soc-state";
	monitored-battery = <&laurel_battery>;
	/* Optional secondary failure must not defer the battery gauge. The
	 * primary notifies after changing the secondary; QG reads that state.
	 */
	power-supplies = <&pmi632_charger>;
	qcom,primary-charger = <&pmi632_charger>;
	qcom,parallel-charger = <&laurel_smb1355>;
	qcom,s2-fifo-length = <4>;
	qcom,s2-acc-length = <128>;
	qcom,s2-acc-interval-ms = <100>;
};

&pmi632_qg_sdam {
	status = "okay";
	/delete-property/ read-only;
	/* LineageOS QG shutdown fields. Cycle/FCC/ESR/PBS cells stay untouched. */
	laurel_qg_soc_valid: soc-valid@46 {
		reg = <0x46 0x1>;
	};
	laurel_qg_soc_state: soc-state@47 {
		reg = <0x47 0x11>;
	};
};

