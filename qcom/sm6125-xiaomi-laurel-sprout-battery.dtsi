/* Stock Laurel SMB1355: QUP SE1, address 0x0c, TLMM130 active-low IRQ. */
&hsusb_phy1 {
	qcom,provide-dpdm;
	laurel_dpdm: dpdm {
		regulator-name = "laurel-phy-dpdm";
	};
};

&pmi632_gpios {
	laurel_smb_en: smb-en-state {
		pins = "gpio2";
		function = "func1";
		output-enable;
	};
	laurel_smb_sense: smb-sense-state {
		pins = "gpio7", "gpio8";
		bias-high-impedance;
		bias-disable;
	};
	laurel_smb_ctm: smb-ctm-state {
		pins = "gpio1";
		bias-high-impedance;
		bias-disable;
	};
};

&tlmm {
	laurel_smb_irq: smb-irq-state {
		pins = "gpio130";
		function = "gpio";
		bias-pull-up;
		input-enable;
	};
};

&i2c1 {
	status = "okay";
	laurel_smb1355: charger@c {
		compatible = "qcom,smb1355";
		reg = <0xc>;
		interrupt-parent = <&tlmm>;
		interrupts = <130 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&laurel_smb_irq &laurel_smb_en &laurel_smb_sense &laurel_smb_ctm>;
	};
};
